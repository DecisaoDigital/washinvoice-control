<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <!-- FCM push notifications (Android 13+ exige runtime permission). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Vibração no aviso em foreground (HapticFeedback). -->
    <uses-permission android:name="android.permission.VIBRATE"/>
    <!-- Auto-update: instalar a própria actualização sem passar pelo browser. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
    <application
        android:label="WashInvoice Control"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="AIzaSyC4dFkCF3p2yRiUFyJkt4YZx0FbbPmMnCI"/>
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <!-- Quem trata o link de recuperação é o `app_links` (por dentro do
                 supabase_flutter), não o Navigator.

                 Sem isto o motor do Flutter entrega o link *também* como rota e
                 tenta `pushNamed('/auth/callback')`. Este MaterialApp só tem
                 `home:` — sem `routes`, sem `onGenerateRoute` — por isso a rota
                 não existe e o `_onUnknownRoute` rebenta com "Null check
                 operator used on a null value" a cada link. Não mata a app, mas
                 suja o arranque e esconde erros a sério no meio do ruído.
                 Apanhado no Redmi a 4 de Agosto de 2026. -->
            <meta-data
              android:name="flutter_deeplinking_enabled"
              android:value="false"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- O link do email de recuperação volta por aqui.

                 Filtro à parte do LAUNCHER de propósito: os filtros são
                 alternativas, não uma lista de requisitos. Juntar MAIN/LAUNCHER
                 e VIEW/BROWSABLE no mesmo bloco fá-los-ia combinar-se entre si
                 e o ícone deixaria de aparecer na gaveta.

                 O esquema é `washinvoicecontrol`, e não o `washinvoice` do POS:
                 são apps diferentes na mesma conta Supabase, e sem esquema
                 próprio o link caía no `site_url` global — abria o POS, não
                 esta app. Ver `washinvoicecontrol://auth/callback` na allowlist
                 do projecto. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="washinvoicecontrol" android:host="auth"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
